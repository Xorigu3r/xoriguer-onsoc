{
  "name": "xoriguer-onsoc",
  "version": "1.0.0",
  "private": true,
  "description": "Xoriguer On Sóc: ubicació compartida i xifrada de la família, amb botó SOS",
  "scripts": {
    "icons": "python -I eines/genera_logo.py && npx capacitor-assets generate --android --ios --iconBackgroundColor #1B3455 --splashBackgroundColor #1E2A3B --splashBackgroundColorDark #1E2A3B",
    "test": "node test.mjs",
    "serve": "node scripts/serve.mjs 8796",
    "copy:web": "node scripts/copia-lib.mjs",
    "sync": "npm run copy:web && npx cap sync",
    "apk": "npm run copy:web && npx cap sync android && powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "1.3.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.0.2",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@capacitor/assets": "4.0.0",
    "@capacitor/cli": "8.6.0"
  }
}
